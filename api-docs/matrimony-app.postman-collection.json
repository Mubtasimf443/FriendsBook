  "item": [
    {
      "name": "Authentication",
      "description": "Authentication related endpoints",
      "item": [
        {
          "name": "Create Registration Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/create-registration-session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "create-registration-session"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profileCreatedBy\": \"self\",\n  \"age\": 25,\n  \"gender\": \"male\",\n  \"name\": \"John Doe\",\n  \"dateOfBirth\": \"2000-01-01T00:00:00.000Z\",\n  \"email\": \"user@example.com\",\n  \"height\": \"5 foot 8 inch\",\n  \"weight\": 70,\n  \"isEducated\": true,\n  \"education\": [\n    {\n      \"level\": \"Bachelor's Degree\",\n      \"certificate\": \"BSc in Computer Science\",\n      \"institution\": \"University Name\",\n      \"yearOfCompletion\": 2022,\n      \"grade\": \"3.5 CGPA\",\n      \"additionalInfo\": \"string\"\n    }\n  ],\n  \"address\": {\n    \"country\": \"Bangladesh\",\n    \"division\": {\n      \"id\": \"1\",\n      \"name\": \"Dhaka\"\n    },\n    \"district\": {\n      \"id\": \"1\",\n      \"division_id\": \"1\",\n      \"name\": \"Dhaka\"\n    },\n    \"upazila\": {\n      \"id\": \"1\",\n      \"district_id\": \"1\",\n      \"name\": \"Uttara\"\n    },\n    \"union\": {\n      \"id\": \"1\",\n      \"upazilla_id\": \"1\",\n      \"name\": \"Union Name\"\n    }\n  },\n  \"phoneInfo\": {\n    \"number\": \"1234567890\",\n    \"country\": {\n      \"name\": \"Bangladesh\",\n      \"phone_code\": \"+880\"\n    }\n  },\n  \"languages\": [\"Bengali\", \"English\"],\n  \"religion\": \"Islam\",\n  \"password\": \"StrongPassword123!\",\n  \"confirmPassword\": \"StrongPassword123!\"\n}"
            }
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/auth/create-registration-session"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Registration session created successfully\",\n  \"data\": {\n    \"sessionKey\": \"64-character-hex-string\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Request Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/request-registration-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "request-registration-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionKey\": \"64-character-hex-string\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Verify Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-registration-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-registration-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionKey\": \"64-character-hex-string\",\n  \"otp\": \"123456\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loginType\": \"with_email\",\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Profile",
      "description": "Profile management endpoints",
      "item": [
        {
          "name": "Get User Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/profile/user-details",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profile", "user-details"],
              "query": [
                {
                  "key": "fields",
                  "value": "name,email,phone",
                  "description": "Comma-separated list of fields to retrieve"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update User Details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/profile/user-details",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profile", "user-details"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"gender\": \"male\",\n  \"dateOfBirth\": \"2000-01-01\",\n  \"age\": 25,\n  \"weight\": 70,\n  \"height\": \"5.8\",\n  \"maritalStatus\": \"single\"\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
